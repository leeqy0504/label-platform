# Local development values only. Replace passwords in production.
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform-dev-password

# Host-process URLs used by `uv run` and integration tests.
PLATFORM_DATABASE_URL=postgresql+psycopg://platform:platform-dev-password@127.0.0.1:5432/platform
PLATFORM_REDIS_URL=redis://127.0.0.1:6379/0
PLATFORM_MANAGED_DATA_ROOT=./var/managed
PLATFORM_ENVIRONMENT=development
PLATFORM_LABEL_STUDIO_URL=http://127.0.0.1:8081
PLATFORM_LABEL_STUDIO_PUBLIC_URL=http://127.0.0.1:8081
PLATFORM_LABEL_STUDIO_API_TOKEN=
PLATFORM_LABEL_STUDIO_MOUNT_ROOT=./var/managed
PLATFORM_LABEL_STUDIO_EXPORT_ROOT=./var/labelstudio/exports
PLATFORM_LABEL_STUDIO_TIMEOUT_SECONDS=120
PLATFORM_UNITRAIN_URL=http://127.0.0.1:8090
PLATFORM_UNITRAIN_API_TOKEN=
PLATFORM_UNITRAIN_EXPORT_ROOT=./var/unitrain/exports
PLATFORM_UNITRAIN_MOUNT_ROOT=./var/unitrain/exports
PLATFORM_UNITRAIN_TIMEOUT_SECONDS=120

# Thin UnitTrain HTTP wrapper. Framework environments are configured separately.
UNITRAIN_API_RUN_ROOT=./var/unitrain/runs
UNITRAIN_API_API_TOKEN=
UNITRAIN_API_PUBLIC_URL=http://127.0.0.1:8090
UNITRAIN_API_HOST=127.0.0.1
UNITRAIN_API_PORT=8090
UNITRAIN_API_MAX_CONCURRENT_RUNS=1

# Compose bind mounts. Source data is always mounted read-only in API and worker containers.
SOURCE_DATA_PATH=./var/sources
MANAGED_DATA_PATH=./var/managed
JOB_LOG_PATH=./var/logs/jobs
LABEL_STUDIO_EXPORT_PATH=./var/labelstudio/exports
LABEL_STUDIO_APP_PATH=./var/labelstudio/app
UNITRAIN_EXPORT_PATH=./var/unitrain/exports
UNITRAIN_RUN_PATH=./var/unitrain/runs

# Required production overrides: POSTGRES_PASSWORD and externally managed TLS/hostnames.
